# Server/CLI only. Copy to .env and obtain auth from your Console export.
# Never reference these variables from web-src.
AIO_runtime_namespace=YOUR_RUNTIME_NAMESPACE
AIO_runtime_auth=

# Backend only. Set these from your own OAuth Web App credentials.
FRAMEIO_CLIENT_ID=
FRAMEIO_CLIENT_SECRET=
# OAuth currently uses hosted Stage. Change only if explicitly testing local OAuth.
FRAMEIO_REDIRECT_URI=https://27200-msofficetoframe-stage.adobeio-static.net/oauth-callback.html
FRAMEIO_SCOPES="openid email profile offline_access additional_info.roles"
# 32-byte random hex key; preserve across restarts. Never put it in web assets.
FRAMEIO_TOKEN_KEY=
